{
  "name": "@vmaria/hand-drawn-icons",
  "description": "Hand-drawn Lucide icons for React, with roughness, hatch, and fill controls.",
  "version": "0.1.0",
  "license": "ISC",
  "homepage": "https://github.com/vasilache06/hand-drawn-icons#readme",
  "bugs": "https://github.com/vasilache06/hand-drawn-icons/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilache06/hand-drawn-icons.git",
    "directory": "packages/lucide-react"
  },
  "keywords": [
    "icons",
    "react",
    "hand-drawn",
    "lucide",
    "svg",
    "rough",
    "vmaria"
  ],
  "author": "vmaria",
  "publishConfig": {
    "access": "public"
  },
  "amdName": "vmaria-hand-drawn-icons",
  "main": "dist/cjs/lucide-react.js",
  "module": "dist/esm/lucide-react.mjs",
  "typings": "dist/lucide-react.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "dynamic.js",
    "dynamic.mjs",
    "dynamic.mjs.map",
    "dynamic.d.mts",
    "dynamic.d.ts",
    "dynamicIconImports.mjs",
    "dynamicIconImports.d.ts",
    "dynamicIconImports.d.mts"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copy:license && pnpm build:icons && pnpm typecheck && pnpm build:bundles",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist && rm -rf stats && rm -rf ./src/icons/*.ts && rm -f dynamic.{d.ts,d.mts,mts,mjs,mjs.map} && rm -f dynamicIconImports.d.ts",
    "build:icons": "build-icons --output=./src --templateSrc=./scripts/exportTemplate.mts --renderUniqueKey --withAliases --withDynamicImports --separateAliasesFile --separateAliasesFileIgnore=fingerprint --aliasesFileExtension=.ts --iconFileExtension=.ts --exportFileName=index.ts",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "typecheck": "tsc",
    "typecheck:watch": "tsc -w",
    "test": "pnpm build:icons && vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@lucide/build-icons": "workspace:*",
    "@lucide/rollup-plugins": "workspace:*",
    "@lucide/shared": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-serializer-html": "^7.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "react": "^16.5.1 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  }
}
